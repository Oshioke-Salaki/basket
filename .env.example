# Basket server configuration. Copy to .env.local and fill in.

# Receipt and price-tag reading: set either key. With both, RECEIPT_READER picks one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
# RECEIPT_READER=openai

# Tatum: Sui gRPC reads and the Data API rates. Free plan is enough. https://dashboard.tatum.io
TATUM_API_KEY=

# Walrus Memory on mainnet. Create the account and a delegate key at https://memory.walrus.xyz/dashboard
# MEMWAL_PRIVATE_KEY is the delegate key's private key (hex or suiprivkey1...); keep it server-side.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Optional: prefix for household namespaces in the shared memory account.
BASKET_NAMESPACE_PREFIX=basket

# Optional: basket key (bsk_...) of the public demo household, opened read-only from the landing page.
BASKET_DEMO_KEY=

# Tests only: replace Walrus, Tatum and Claude with in-process fakes. Refused in production.
BASKET_FAKE_SERVICES=0
